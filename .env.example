# Configuration de pose-parquet-ai.
#
# Toutes les valeurs ont un défaut raisonnable dans app/core/config.py :
# ce fichier ne sert qu'à surcharger localement. Copiez-le en `.env`.
# `.env` n'est jamais versionné — aucun secret ne doit apparaître ici.

# --- Service ---------------------------------------------------------------
PPAI_LOG_LEVEL=INFO
# json en production (logs structurés), text en développement.
PPAI_LOG_FORMAT=text

# Origines autorisées pour CORS, séparées par des virgules.
# Vide = aucune origine navigateur autorisée (défaut volontaire).
PPAI_CORS_ORIGINS=

# --- Limites d'upload ------------------------------------------------------
# 20 Mo, aligné sur docs/future-ai-api-contract.md du front.
PPAI_MAX_UPLOAD_BYTES=20971520
# Garde-fou anti bombe de décompression (pixels décodés).
PPAI_MAX_IMAGE_PIXELS=50000000
# Côté le plus long en dessous duquel une photo est jugée trop petite.
PPAI_MIN_LONG_SIDE=640

# --- Seuils de classification (JAMAIS universels, voir docs/architecture.md) --
PPAI_BLUR_WORKING_SIDE=1024
PPAI_BLUR_SHARP_MIN=120.0
PPAI_DARK_LUMA_MAX=0.06
PPAI_BRIGHT_LUMA_MIN=0.98
PPAI_DARK_RATIO_MAX=0.35
PPAI_BRIGHT_RATIO_MAX=0.12
PPAI_LUMA_MEAN_MIN=0.12
PPAI_LUMA_MEAN_MAX=0.85
PPAI_CONTRAST_MIN=0.05

# --- Analyse d'objectif ----------------------------------------------------
# Flèche d'arc (px) au-delà de laquelle on soupçonne une distorsion,
# exprimée pour une largeur de référence de 1600 px.
PPAI_LENS_SAGITTA_SUSPECT_PX=3.0
PPAI_LENS_MAX_FIT_RMS_PX=2.0
PPAI_LENS_MIN_TRACK_POINTS=40
