# Configuration de pose-parquet-ai.
#
# Toutes les valeurs ont un défaut raisonnable dans app/core/config.py :
# ce fichier ne sert qu'à surcharger localement. Copiez-le en `.env`.
# `.env` n'est jamais versionné — aucun secret ne doit apparaître ici.

# --- Service ---------------------------------------------------------------
PPAI_LOG_LEVEL=INFO
# json en production (logs structurés), text en développement.
PPAI_LOG_FORMAT=text

# Origines autorisées pour CORS, séparées par des virgules.
# Vide = aucune origine navigateur autorisée (défaut volontaire).
PPAI_CORS_ORIGINS=

# --- Poste de travail UNIQUEMENT — jamais en production --------------------
#
# Les trois réglages ci-dessous sont faux par défaut, et ce défaut est ce qui
# part en production. Les lever est une décision de machine de développement ;
# aucune image, aucun déploiement ne doit les porter.

# DEV ONLY. Servir aussi le visualiseur (`tools/` et `web/`) depuis ce
# processus : une seule commande pour l'interface et l'analyse, donc aucun
# CORS. Ce drapeau ouvre AUSSI /docs, /redoc et /openapi.json.
#
# `datasets/` n'est jamais servi, même ici : il contient des photos de
# domicile (voir app/main.py, DOSSIERS_DE_DEV).
PPAI_DEV_SERVE_STATIC=0

# EXPERIMENTAL ONLY. Joindre à l'analyse une segmentation du sol
# exploratoire. Ce n'est PAS une fonction de produit :
#   — le bloc renvoyé s'appelle `experimental`, il ne remplit jamais
#     `sceneData`, et aucun parquet n'est posé dessus ;
#   — le modèle se charge en dizaines de secondes et une inférence prend
#     plusieurs secondes sur processeur.
# Aucun modèle n'est retenu à ce jour : voir docs/FLOOR-SEGMENTATION-EXPLORATORY.md.
PPAI_EXPERIMENTAL_FLOOR=0

# EXPERIMENTAL ONLY. Le candidat regardé quand le drapeau ci-dessus est vrai.
# `opencv` ne télécharge rien ; `oneformer` et `upernet` tirent des poids
# depuis Hugging Face au premier appel.
# Valeurs : opencv | oneformer | upernet
PPAI_EXPERIMENTAL_FLOOR_CANDIDATE=opencv

# EXPERIMENTAL ONLY. Confiance sous laquelle la scène expérimentale n'est PAS
# posée automatiquement : la photo reste nue, l'interface propose d'ajuster
# le sol. Borne de prudence, pas un seuil calibré — il n'existe aucune vérité
# terrain pour cette chaîne.
PPAI_EXPERIMENTAL_FLOOR_MIN_CONFIDENCE=0.55

# --- Limites d'upload ------------------------------------------------------
# 20 Mo, aligné sur docs/future-ai-api-contract.md du front.
PPAI_MAX_UPLOAD_BYTES=20971520
# Garde-fou anti bombe de décompression (pixels décodés).
PPAI_MAX_IMAGE_PIXELS=50000000
# Côté le plus long en dessous duquel une photo est jugée trop petite.
PPAI_MIN_LONG_SIDE=640

# --- Seuils de classification (JAMAIS universels, voir docs/architecture.md) --
PPAI_BLUR_WORKING_SIDE=1024
PPAI_BLUR_SHARP_MIN=120.0
PPAI_DARK_LUMA_MAX=0.06
PPAI_BRIGHT_LUMA_MIN=0.98
PPAI_DARK_RATIO_MAX=0.35
PPAI_BRIGHT_RATIO_MAX=0.12
PPAI_LUMA_MEAN_MIN=0.12
PPAI_LUMA_MEAN_MAX=0.85
PPAI_CONTRAST_MIN=0.05

# --- Analyse d'objectif ----------------------------------------------------
# Flèche d'arc (px) au-delà de laquelle on soupçonne une distorsion,
# exprimée pour une largeur de référence de 1600 px.
PPAI_LENS_SAGITTA_SUSPECT_PX=3.0
PPAI_LENS_MAX_FIT_RMS_PX=2.0
PPAI_LENS_MIN_TRACK_POINTS=40
